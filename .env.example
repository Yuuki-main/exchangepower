# Copy to .env.local for local development and fill in. Never commit real values.
# In production, set these in Vercel: Project → Settings → Environment Variables.
# All are server-only: never prefix them with NEXT_PUBLIC_.
#
# Without RESEND_API_KEY in development, enquiries are printed to the
# `npm run dev` console instead of being sent. In production a missing value
# makes the form show a "please call or email us" message.

# Resend API key, from https://resend.com/api-keys ("Sending access" is enough).
# Also used to sign the form's anti-spam token, so changing it invalidates open forms.
RESEND_API_KEY=

# Where enquiries are delivered. Separate several addresses with commas.
# While CONTACT_FROM_EMAIL uses onboarding@resend.dev, this must be the
# email address of the Resend account owner.
CONTACT_TO_EMAIL=

# The sender. Must be on a domain verified in Resend, for example:
#   CONTACT_FROM_EMAIL="Exchange Power <enquiries@exchangepower.com.au>"
# Until the domain is verified, use Resend's test sender:
#   CONTACT_FROM_EMAIL="Exchange Power <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=
