# Copy to .env.local and fill in. Never commit real values.
# Server-only: do not prefix any of these with NEXT_PUBLIC_.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Address that receives website enquiries
CONTACT_TO_EMAIL=
# Verified Resend sender, e.g. "Exchange Power <enquiries@exchangepower.com.au>"
CONTACT_FROM_EMAIL=
